{
  "name": "youra",
  "private": true,
  "version": "3.0.0",
  "description": "YOURA: curated 360° video you look around by moving your phone.",
  "scripts": {
    "build": "esbuild js/main.js --bundle --format=iife --target=es2020,safari15 --minify --legal-comments=none --outfile=app.js",
    "watch": "esbuild js/main.js --bundle --format=iife --target=es2020,safari15 --sourcemap --outfile=app.js --watch",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "three": "^0.170.0"
  }
}
